exports[`MuiChip theme styles should keep the outlined caution medium removable disabled styles 1`] = `
{
  "label": {
    "&": {
      "font": "var(--font-body-small-400)",
    },
  },
  "root": {
    "&": {
      "-ms-flex": "none",
      "-webkit-flex": "none",
      "background-color": "var(--palette-caution-light)",
      "border": "1px solid rgba(var(--palette-caution-mainChannel) / 0.7)",
      "color": "var(--palette-caution-main)",
      "flex": "none",
      "font-family": "Inter",
      "height": "24px",
    },
    "& .MuiChip-deleteIcon": {
      "color": "inherit",
      "margin": "0 -2px 0 0",
    },
    "& .MuiChip-deleteIcon:active": {
      "color": "var(--palette-caution-main)",
    },
    "& .MuiChip-deleteIcon:hover": {
      "color": "var(--palette-caution-main)",
    },
    "&.Mui-focusVisible": {
      "background": "var(--palette-caution-dark)",
      "background-color": "rgba(var(--palette-caution-mainChannel) / calc(var(--palette-action-focusOpacity)))",
    },
    "&.MuiChip-clickable:hover": {
      "background-color": "rgba(var(--palette-caution-mainChannel) / calc(var(--palette-action-hoverOpacity)))",
    },
    "&:focus-visible": {
      "outline": "2px solid var(--palette-primary-main)",
      "outline-offset": "2px",
    },
    "&:hover": {
      "background-color": "var(--palette-caution-dark)",
    },
  },
}
`;

